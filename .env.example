# NoteAI - Backend Integration Configuration
# FastAPI Backend Base URL (do not include trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# Development / Offline Mock Fixtures toggle
# Set to 'true' to use rich local development fixtures when backend is not yet running
# Set to 'false' to connect directly to the live FastAPI backend
VITE_USE_MOCK_DATA=true

# Default Audio Chunk Target Duration in Milliseconds (Default: 5 minutes = 300000 ms)
# For rapid testing, you can change this to 30000 (30 seconds) or 60000 (1 minute)
VITE_CHUNK_INTERVAL_MS=300000

